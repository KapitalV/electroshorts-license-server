# Supabase project settings. Keep server keys only on the private license API host.
SUPABASE_URL=https://your-project.supabase.co
# Preferred: copy the project's sb_secret_ key from Settings > API Keys.
SUPABASE_SECRET_KEY=
# Legacy fallback only when SUPABASE_SECRET_KEY is blank: service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
# Never use sb_publishable_ or anon keys here. Never bundle either server key.

# Long random values; never expose either token to the desktop app.
LICENSE_ADMIN_TOKEN=replace-with-admin-token
LICENSE_KEY_HASH_PEPPER=replace-with-random-pepper

# Base64 of 32 raw Ed25519 private-key bytes. Server only: never bundle this.
# Bundle the corresponding raw public key in backend/release-config.json.
LICENSE_RECEIPT_PRIVATE_KEY=

